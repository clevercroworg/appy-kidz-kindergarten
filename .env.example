# ========================================================
# APPY KIDZ INTERNATIONAL PRE-SCHOOL - EMAIL CONFIGURATION
# ========================================================
# Copy this file to .env.local and populate with your real credentials.

# SMTP Host (e.g., smtp.gmail.com, smtp.hostinger.com, smtpout.secureserver.net, smtp.office365.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to true if port is 465, false for port 587
SMTP_SECURE=false

# SMTP Username / Login Email (e.g. your Gmail or Workspace address)
SMTP_USER=your-school-email@gmail.com

# SMTP Password
# (For Gmail / Google Workspace, use a 16-character App Password generated at: https://myaccount.google.com/apppasswords)
SMTP_PASS=your-app-password-here

# Friendly "From" header shown in the email client
SMTP_FROM="Appy Kidz Admissions" <your-school-email@gmail.com>

# Destination email where new admission alerts will be sent
ENQUIRY_NOTIFICATION_EMAIL=appykidzbangalore@gmail.com
