    <!-- ========================================================================
         PROUD MOMENTS — DEDICATED RECOGNITION SECTION
         (Strictly complies with all user requirements:
          - Dedicated, visually integrated section: “PROUD MOMENTS”
          - Not a corporate awards wall; proud milestone in the Appy Kidz story.
          - LEFT: large photograph of actual award/trophy and certificate.
          - RIGHT: large playful statement: “Little Steps. Big Recognition.”
          - Supporting copy: “Appy Kidz International Pre School, Bangalore was recognized with the Best Pre School Startup award at the 30th Edition of the Indian School Awards.”
          - Small “Indian School Awards” badge / decorative seal.
          - Palette: warm yellow, gold, cream, lime with Appy Kidz colors.
          - Real award photograph dominant. Small decorative trophy illustration nearby.)
         ======================================================================== -->
    <section class="section proud-moments-section" id="proud-moments" aria-labelledby="proudMomentsHeading">
      <div class="container proud-moments-container">
        <div class="proud-moments-grid">
          
          <!-- LEFT: Real Photograph of Actual Award / Trophy and Certificate -->
          <div class="award-photo-column">
            <div class="award-main-frame">
              <div class="award-main-photo-wrap" title="Click to view full high-resolution photograph">
                <img id="awardMainImg" src="/assets/award-stage.jpg" alt="Appy Kidz International Pre School receiving the Best Pre School Startup award on stage at the Indian School Awards" />
                <div class="award-zoom-hint">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
                  Click to View Full Photo
                </div>
              </div>

              <!-- Multi-View Tabs for Authentic Evidence -->
              <div class="award-tabs-wrapper" role="tablist" aria-label="Authentic Award Photos">
                <button type="button" class="award-tab-btn active" role="tab" aria-selected="true" data-img-src="/assets/award-stage.jpg" data-img-alt="Appy Kidz Leadership receiving award on stage" data-img-caption="Official Stage Ceremony Presentation: 30th Edition Indian School Awards, Bangalore">
                  📸 Ceremony Stage Photo
                </button>
                <button type="button" class="award-tab-btn" role="tab" aria-selected="false" data-img-src="/assets/award-certificate.jpg" data-img-alt="Certificate of Recognition - Best Pre School Startup" data-img-caption="Official Certificate of Recognition presented to Appy Kidz International Pre School, Bangalore">
                  📜 Certificate of Recognition
                </button>
                <button type="button" class="award-tab-btn" role="tab" aria-selected="false" data-img-src="/assets/award-trophy.jpg" data-img-alt="Indian School Awards Trophy Plaque" data-img-caption="Best Pre School Startup Wooden &amp; Gold Award Plaque">
                  🏆 Award Trophy Plaque
                </button>
                <button type="button" class="award-tab-btn" role="tab" aria-selected="false" data-img-src="/assets/award-full.jpg" data-img-alt="Complete Trophy Plaque and Certificate Photo" data-img-caption="Authentic close-up view of the original trophy plaque and certificate">
                  🔍 Complete Award View
                </button>
              </div>
            </div>
          </div>

          <!-- RIGHT: Large Playful Statement & Factual Recognition Copy -->
          <div class="award-content-column">
            <!-- Small “Indian School Awards” badge / decorative seal -->
            <div class="award-badge-seal">
              <span class="award-seal-icon" aria-hidden="true">🎖️</span>
              <span>30th Edition · Indian School Awards, Bangalore</span>
            </div>

            <!-- Large playful statement: “Little Steps. Big Recognition.” -->
            <h2 class="award-playful-title" id="proudMomentsHeading">
              Little Steps.
              <span>Big Recognition.</span>
            </h2>

            <!-- Supporting copy: strictly factual and concise as specified -->
            <p class="award-supporting-copy">
              Appy Kidz International Pre School, Bangalore was recognized with the <strong>Best Pre School Startup</strong> award at the 30th Edition of the Indian School Awards.
            </p>

            <!-- Authentic Citation Box from Certificate -->
            <div class="award-citation-box">
              <p class="award-citation-text">
                &ldquo;For demonstrating exceptional performance in fostering a holistic learning environment, promoting global citizenship, and implementing innovative teaching practices.&rdquo;
              </p>
              <div class="award-citation-source">
                — Official Citation on Certificate of Recognition
              </div>
            </div>

            <!-- Authentic Metadata Badges -->
            <div class="award-meta-row">
              <div class="award-meta-pill">
                <span>Award:</span>
                <strong>Best Pre School Startup</strong>
              </div>
              <div class="award-meta-pill">
                <span>Presented to:</span>
                <strong>Appy Kidz International Pre School, Bangalore</strong>
              </div>
            </div>

            <!-- Action & Decorative Trophy Illustration Companion -->
            <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
              <button type="button" class="btn btn-primary" data-open-visit-modal>
                Book a School Visit
                <span class="btn-icon-pill" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </button>

              <div class="award-illustration-companion">
                <div class="trophy-mini-art" aria-hidden="true">🏆</div>
                <div class="award-companion-text">A milestone celebrated together with our parents &amp; children!</div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================
         PROGRAMS SECTION
         (Ages 1.5 – 6 Years + Daycare)
         ======================================================================== -->
    <section class="section programs-section" id="programs" aria-labelledby="programsHeading">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow-pill green">
            <span>📚 Nurturing Early Growth</span>
          </div>
          <h2 id="programsHeading">Joyful Learning Tailored to Every Age</h2>
          <p>
            From gentle sensory discovery to primary school readiness, our play-based curriculum encourages children to explore, communicate, and create.
          </p>
        </div>

        <div class="programs-grid">
          <!-- Playgroup -->
          <div class="card-bezel program-card playgroup">
            <div class="card-bezel-inner program-inner">
              <span class="program-age-tag">1.5 – 2.5 Years</span>
              <h3 class="program-title">Playgroup</h3>
              <p class="program-desc">
                A warm, nurturing transition from home. Toddlers explore sensory textures, rhythm, rhymes, and social bonding through joyful interactive play.
              </p>
              <ul class="program-features-list">
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Sensory &amp; tactile exploration
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Fine &amp; gross motor milestones
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Gentle social communication
                </li>
              </ul>
              <button type="button" class="btn btn-secondary" data-open-visit-modal data-program-preset="Playgroup" style="width: 100%;">
                Inquire for Playgroup
              </button>
            </div>
          </div>

          <!-- Nursery -->
          <div class="card-bezel program-card nursery">
            <div class="card-bezel-inner program-inner">
              <span class="program-age-tag">2.5 – 3.5 Years</span>
              <h3 class="program-title">Nursery</h3>
              <p class="program-desc">
                Expanding vocabulary, storytelling, numbers, and fine motor skills in vibrant learning corners filled with colorful puzzles, songs, and shapes.
              </p>
              <ul class="program-features-list">
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Early language &amp; phonics sounds
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Pre-math shapes &amp; patterns
                </li>
                <li>
