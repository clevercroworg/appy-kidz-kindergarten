     title="Chat with Appy Kidz on WhatsApp"
     aria-label="Chat With Us on WhatsApp">
    <div class="floating-whatsapp-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/></svg>
    </div>
    <span class="floating-whatsapp-label">Chat With Us</span>
  </a>

  <!-- ========================================================================
       INTERACTIVE MODAL: BOOK A SCHOOL VISIT / ADMISSION ENQUIRY
       ======================================================================== -->
  <div class="modal-backdrop" id="visitModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-window">
      <div class="modal-header">
        <h3 id="modalTitle">Book a School Visit</h3>
        <p>Come meet our team and discover our joyful campus in Kithaganur, Bangalore.</p>
        <button type="button" class="modal-close-btn" id="visitModalClose" aria-label="Close modal">&times;</button>
      </div>
      <div class="modal-body">
        <form id="visitBookingForm">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="parentName">Parent's Name *</label>
              <input type="text" id="parentName" name="parentName" class="form-input" placeholder="e.g. Priya Sharma" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Phone / WhatsApp Number *</label>
              <input type="tel" id="phone" name="phone" class="form-input" placeholder="e.g. 9876543210" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="childName">Child's Name</label>
              <input type="text" id="childName" name="childName" class="form-input" placeholder="e.g. Aarav" />
            </div>
            <div class="form-group">
              <label class="form-label" for="program">Interested Program *</label>
              <select id="program" name="program" class="form-select" required>
                <option value="Playgroup (1.5 - 2.5 yrs)">Playgroup (1.5 – 2.5 Years)</option>
                <option value="Nursery (2.5 - 3.5 yrs)">Nursery (2.5 – 3.5 Years)</option>
                <option value="Junior KG / LKG (3.5 - 4.5 yrs)">Junior KG / LKG (3.5 – 4.5 Years)</option>
                <option value="Senior KG / UKG (4.5 - 6 yrs)">Senior KG / UKG (4.5 – 6 Years)</option>
                <option value="Daycare & Extended Care">Daycare &amp; Extended Care</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="visitDate">Preferred Visit Date</label>
              <input type="date" id="visitDate" name="visitDate" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label" for="timeSlot">Preferred Time Slot</label>
              <select id="timeSlot" name="timeSlot" class="form-select">
                <option value="Morning (9:30 AM - 12:00 PM)">Morning (9:30 AM – 12:00 PM)</option>
                <option value="Afternoon (1:00 PM - 3:30 PM)">Afternoon (1:00 PM – 3:30 PM)</option>
                <option value="Evening (4:00 PM - 5:30 PM)">Evening (4:00 PM – 5:30 PM)</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="notes">Any questions or notes?</label>
            <textarea id="notes" name="notes" rows="2" class="form-textarea" placeholder="Tell us if you have any questions or dietary/care requests..."></textarea>
          </div>

          <div class="form-submit-actions">
            <!-- 1-Click WhatsApp Booking -->
            <button type="submit" class="btn btn-whatsapp" style="width: 100%;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/></svg>
              Confirm &amp; Book via WhatsApp
            </button>
            <button type="button" class="btn btn-secondary" id="modalWhatsAppQuickBtn" style="width: 100%;">
              Quick Chat via WhatsApp (+91 70222 61013)
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

